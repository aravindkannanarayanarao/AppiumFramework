    "version": "0.2.0",
        "configurations": [
          {
            "type": "coreclr",
            "request": "launch",
            "name": "Generate NuGet Packages",
            "program": "dotnet",
            "args": [
              "pack",
              "${workspaceFolder}/src/Syncfusion.UITestHelpers.sln",
              "--configuration",
              "Release",
              "--output",
              "${workspaceFolder}/build/nuget-packages"
            ],
            "preLaunchTask": "build-solution"
          }
        ]
        
}
